# Copy to .env, fill in, then:  source .env     (never commit .env)
# Keys live in a Foundry keystore, NOT in this file:
#   cast wallet import testdeployer --interactive
ACCOUNT=testdeployer

BASE_SEPOLIA_RPC=https://sepolia.base.org
LASNA_RPC=https://lasna-rpc.rnk.dev

# Fill in as you deploy (steps 1-3 in the README)
ORIGIN_ADDRESS=
REACTIVE_ADDRESS=
CALLBACK_ADDRESS=

# Optional overrides
# CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
# REACTIVE_FUND_WEI=1000000000000000000
# CALLBACK_FUND_WEI=5000000000000000
# PING_VALUE=42

# ---------------- Week 2: Guardian Vault (fill in as you deploy) ----------------
VOL_ADDRESS=
STABLE_ADDRESS=
POOL_ADDRESS=
ORACLE_ADDRESS=
G_REACTIVE_ADDRESS=
VAULT_ADDRESS=
# Optional overrides
# AI_SIGNER_ADDRESS=            # defaults to the deployer; use a separate wallet for the AI service in week 3
# HIGH_THRESHOLD=70             # de-risk at score >= this
# LOW_THRESHOLD=30              # re-risk at score <= this
# COOLDOWN_SECONDS=60
# MAX_AGE_SECONDS=600
# POOL_LIQUIDITY_WEI=10000000000000000000000
# VAULT_FUND_WEI=10000000000000000
# SEED_VOL_WEI=100000000000000000000
# DUMP_VOL_WEI=5000000000000000000000
# RECOVER_STABLE_WEI=3300000000000000000000
# RISK_SCORE=90
# RISK_REASON="manual test verdict"
