# Copy to ai/.env (or just run:  npm run keygen  which creates it and the AI wallet for you).
# NEVER commit ai/.env. The AI_PRIVATE_KEY wallet only needs ~0.005 Base Sepolia ETH.

RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# From the Week 2 deployment (same values as the main .env)
POOL_ADDRESS=
ORACLE_ADDRESS=
VAULT_ADDRESS=

# Created by `npm run keygen`
AI_PRIVATE_KEY=

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tuning (defaults shown)
# WINDOW_SEC=300
# POLL_MS=3000
# EVAL_INTERVAL_SEC=15
# MIN_PUBLISH_INTERVAL_SEC=20
# DELTA_TO_PUBLISH=15
# HEARTBEAT_SEC=240
# HIGH_THRESHOLD=70
# LOW_THRESHOLD=30
# GUARD_BAND=30

# --- optional extras, all off by default (see README, "Optional extras") ---
# CALM_CAP=1          # rule score <= CALM_RULE: final score cannot stay above the re-risk threshold
# CALM_RULE=5
# NN_ENABLED=1        # small neural network (ai/model/mlp.json) as a second signal
# NN_MODE=asym        # asym: NN can only raise the score unless the pool is calm; blend: plain weighted mix
# NN_WEIGHT=0.5
# NN_CALM_RULE=5
